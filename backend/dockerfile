# 1. Base image with standard glibc and Python pre-installed
FROM python:3.11-slim

# 2. Prevent Python from buffering logs or creating .pyc files
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 3. Set the working directory inside the container
WORKDIR /app

# 4. Copy the dataset and model artifact folders
COPY datasets/ ./datasets/
COPY model/ ./model/

# 5. Copy dependency list first (leverages Docker layer caching)
COPY requirements.txt .

# 6. Install dependencies without caching package tarballs
RUN pip install --no-cache-dir -r requirements.txt

# 7 Copy the rest of the backend source code
COPY backend/ .

# 8. Document the port the app listens on
EXPOSE 8000

# 9. Start the Uvicorn server bound to 0.0.0.0
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
